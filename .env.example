# Copia este archivo como .env.local para probar con `npx vercel dev`.
# En producción, configura estas variables en Vercel:
# Project → Settings → Environment Variables. NUNCA subas tu clave real a GitHub.
OPENAI_API_KEY=sk-...tu-clave...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Orígenes extra que pueden usar tu API (si juegas desde GitHub Pages):
ALLOWED_ORIGINS=https://fertello29.github.io
